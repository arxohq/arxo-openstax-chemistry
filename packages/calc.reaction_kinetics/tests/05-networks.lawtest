language "law.core" version "0.2";
package calc.reaction_kinetics version "0.1.0";
namespace "urn:law:calc:reaction-kinetics";

// Networks with c0 = 1 mol/l, k1 = 0.1 1/s, k2 = 0.2 1/s, t = 10 s.
// Independent oracles (python3 math):
//   consecutive: c_A = e^-1 = 0.3679; c_B = e^-1 - e^-2 = 0.2325;
//     c_C = 1 - c_A - c_B = 0.3996 (precision 4)
//   equal rates (k1 = k2 = 0.1): c_B = 0.1*10*e^-1 = 0.3679
//   parallel (k1+k2 = 0.3): c_A = e^-3 = 0.0498;
//     y_B = (0.1/0.3)*(1 - e^-3) = 0.3167; y_C = 0.6335
//   catalyst (Ea = 50000, Ea_cat = 40000, R = 8.314, T = 300):
//     speedup = exp(10000/2494.2) = 55.1083... -> 55.11 (precision 2)
//   fit (order 1, k = 0.1, t = 10, obs 0.37): residual = 0.0021 (precision 4)

test "urn:query:calc-kin-n01-consecutive-ok" {
    given {
        assert "n01-c": given_initial_concentration(entity_ref("urn:case:kin:net1"), 1, 1) { origin case_input; }
        assert "n01-k1": given_first_rate(entity_ref("urn:case:kin:net1"), 1, 10) { origin case_input; }
        assert "n01-k2": given_second_rate(entity_ref("urn:case:kin:net1"), 2, 10) { origin case_input; }
        assert "n01-t": given_elapsed(entity_ref("urn:case:kin:net1"), 10, 1) { origin case_input; }
        assert "n01-p": given_output_precision(entity_ref("urn:case:kin:net1"), 4) { origin case_input; }
    }
    evaluate truth(consecutive_b_value(entity_ref("urn:case:kin:net1"), 0.2325));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(ConsecutiveBRounded);
    evaluate truth(consecutive_c_value(entity_ref("urn:case:kin:net1"), 0.3996));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(ConsecutiveCRounded);
}

test "urn:query:calc-kin-n02-consecutive-equal-rates" {
    given {
        assert "n02-c": given_initial_concentration(entity_ref("urn:case:kin:net2"), 1, 1) { origin case_input; }
        assert "n02-k1": given_first_rate(entity_ref("urn:case:kin:net2"), 1, 10) { origin case_input; }
        assert "n02-k2": given_second_rate(entity_ref("urn:case:kin:net2"), 1, 10) { origin case_input; }
        assert "n02-t": given_elapsed(entity_ref("urn:case:kin:net2"), 10, 1) { origin case_input; }
        assert "n02-p": given_output_precision(entity_ref("urn:case:kin:net2"), 4) { origin case_input; }
    }
    evaluate truth(degenerate_equal_rates(entity_ref("urn:case:kin:net2")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(DegenerateEqualRates);
    evaluate truth(consecutive_b_equal_rates_value(entity_ref("urn:case:kin:net2"), 0.3679));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(ConsecutiveBEqualRatesRounded);
    evaluate truth(consecutive_b_value(entity_ref("urn:case:kin:net2"), 0.2325));
    expect truth_status == NEITHER;
}

