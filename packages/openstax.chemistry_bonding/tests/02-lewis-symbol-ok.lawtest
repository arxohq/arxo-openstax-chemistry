language "law.core" version "0.2";
package openstax.chemistry_bonding version "0.1.0";
namespace "urn:openstax:clir:chemistry-bonding";

test "lewis-symbol definition entry is covered" {
 given {
  assert "f0": row_claims(entity_ref("urn:openstax:matrix:m02"), "lewis-symbol") { origin case_input; }
  assert "f1": row_formula(entity_ref("urn:openstax:matrix:m02"), "Lewis symbol is the elemental symbol with one dot per valence electron") { origin case_input; }
  assert "f2": row_layer(entity_ref("urn:openstax:matrix:m02"), "definition") { origin case_input; }
  assert "f3": row_checker(entity_ref("urn:openstax:matrix:m02"), "calc.lewis_structures valence-count") { origin case_input; }
  assert "f4": row_fragment(entity_ref("urn:openstax:matrix:m02"), "section/7.3#lewis-symbols") { origin case_input; }
 }
 evaluate truth(claim_covered(entity_ref("urn:openstax:matrix:m02")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(LewisSymbolCovered);
}
