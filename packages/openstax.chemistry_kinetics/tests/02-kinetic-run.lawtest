language "law.core" version "0.2";
package openstax.chemistry_kinetics version "0.1.1";
namespace "urn:openstax:clir:chemistry-kinetics";

// §12.4, ПЕРВЫЙ ПОРЯДОК: c₀ = 1 моль/л, k = 0.1 1/с, t = 10 с.
// c = e^−1 = 0.367879441171 -> 0.367879 моль/л (точн. 6).
test "urn:query:os-run-01-first-order-concentration" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
            timezone "UTC";
        }
        assert "r01-calc": run_calculation(entity_ref("urn:case:chem:kin:run1"), entity_ref("urn:case:chem:kin:run1-calc")) { origin case_input; }
        assert "r01-n": run_order(entity_ref("urn:case:chem:kin:run1"), 1) { origin case_input; }
        assert "r01-c0": run_initial_concentration(entity_ref("urn:case:chem:kin:run1"), 1, 1) { origin case_input; }
        assert "r01-k": run_rate_constant(entity_ref("urn:case:chem:kin:run1"), 1, 10) { origin case_input; }
        assert "r01-t": run_elapsed(entity_ref("urn:case:chem:kin:run1"), 10, 1) { origin case_input; }
        assert "r01-p": run_precision(entity_ref("urn:case:chem:kin:run1"), 6) { origin case_input; }
    }
    evaluate truth(run_concentration(entity_ref("urn:case:chem:kin:run1"), 0.367879 mol_per_l));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(RunConcentration);
}

// §12.4, ПОЛУПРЕВРАЩЕНИЕ ПЕРВОГО ПОРЯДКА: t½ = ln2/k = 6.931471805599 -> 6.931472 с.
test "urn:query:os-run-02-first-order-half-life" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
            timezone "UTC";
        }
        assert "r02-calc": run_calculation(entity_ref("urn:case:chem:kin:run1"), entity_ref("urn:case:chem:kin:run1-calc")) { origin case_input; }
        assert "r02-n": run_order(entity_ref("urn:case:chem:kin:run1"), 1) { origin case_input; }
        assert "r02-c0": run_initial_concentration(entity_ref("urn:case:chem:kin:run1"), 1, 1) { origin case_input; }
        assert "r02-k": run_rate_constant(entity_ref("urn:case:chem:kin:run1"), 1, 10) { origin case_input; }
        assert "r02-p": run_precision(entity_ref("urn:case:chem:kin:run1"), 6) { origin case_input; }
    }
    evaluate truth(run_half_life(entity_ref("urn:case:chem:kin:run1"), 6.931472 s));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(RunHalfLife);
}

// §12.4, ОБРАТНЫЙ ВОПРОС: цель 1/2 моль/л при тех же c₀ и k —
// t = ln2/0.1 = 6.931472 с.
test "urn:query:os-run-03-first-order-time-to-target" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
            timezone "UTC";
        }
        assert "r03-calc": run_calculation(entity_ref("urn:case:chem:kin:run1"), entity_ref("urn:case:chem:kin:run1-calc")) { origin case_input; }
        assert "r03-n": run_order(entity_ref("urn:case:chem:kin:run1"), 1) { origin case_input; }
        assert "r03-c0": run_initial_concentration(entity_ref("urn:case:chem:kin:run1"), 1, 1) { origin case_input; }
        assert "r03-k": run_rate_constant(entity_ref("urn:case:chem:kin:run1"), 1, 10) { origin case_input; }
        assert "r03-q": run_target_concentration(entity_ref("urn:case:chem:kin:run1"), 1, 2) { origin case_input; }
        assert "r03-p": run_precision(entity_ref("urn:case:chem:kin:run1"), 6) { origin case_input; }
    }
    evaluate truth(run_time_to_target(entity_ref("urn:case:chem:kin:run1"), 6.931472 s));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(RunTimeToTarget);
}

