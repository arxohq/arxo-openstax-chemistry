// §12.6, АРРЕНИУС: Ea = 50000 Дж/моль, R = 8.314, T₁ = 300 К, T₂ = 310 К.
// k₂/k₁ = exp(−Ea/R·(1/T₂ − 1/T₁)) = 1.909156545112 -> 1.909157.
test "urn:query:os-run-10-arrhenius-ratio" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
            timezone "UTC";
        }
        assert "r10-calc": run_calculation(entity_ref("urn:case:chem:kin:arr"), entity_ref("urn:case:chem:kin:arr-calc")) { origin case_input; }
        assert "r10-ea": run_activation_energy(entity_ref("urn:case:chem:kin:arr"), 50000, 1) { origin case_input; }
        assert "r10-r": run_gas_constant(entity_ref("urn:case:chem:kin:arr"), 8314, 1000) { origin case_input; }
        assert "r10-t": run_temperature_pair(entity_ref("urn:case:chem:kin:arr"), 300, 1, 310, 1) { origin case_input; }
        assert "r10-p": run_precision(entity_ref("urn:case:chem:kin:arr"), 6) { origin case_input; }
    }
    evaluate truth(run_arrhenius_ratio(entity_ref("urn:case:chem:kin:arr"), 1.909157));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(RunArrheniusRatio);
}

// §12.6, ОТКАЗ БЕЗ Ea: температуры запрошены, энергии нет — перенос отклонён вслух.
test "urn:query:os-run-11-transfer-refused" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
