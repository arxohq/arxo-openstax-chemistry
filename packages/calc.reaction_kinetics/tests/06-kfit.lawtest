language "law.core" version "0.2";
package calc.reaction_kinetics version "0.1.0";
namespace "urn:law:calc:reaction-kinetics";

// Первый порядок: c0 = 4/1, наблюдение 1/1 при t = 2/1:
// k = ln(4/1)/2 = 0.693147... -> 0.693 (точность 3).
// Подгонка встаёт рядом с оговоркой о механизме.

test "urn:query:calc-kin-kfit01-two-point" {
    given {
        assert "kfit01-o": given_order(entity_ref("urn:case:kin:fit1"), 1) { origin case_input; }
        assert "kfit01-c0": given_initial_concentration(entity_ref("urn:case:kin:fit1"), 4, 1) { origin case_input; }
        assert "kfit01-obs": given_observed_concentration(entity_ref("urn:case:kin:fit1"), 1, 1) { origin case_input; }
        assert "kfit01-t": given_elapsed(entity_ref("urn:case:kin:fit1"), 2, 1) { origin case_input; }
        assert "kfit01-p": given_output_precision(entity_ref("urn:case:kin:fit1"), 3) { origin case_input; }
    }
    evaluate truth(kin_derived_k_value(entity_ref("urn:case:kin:fit1"), 0.693));
    expect truth_status == TRUE_ONLY;
    evaluate truth(fit_not_mechanism_proof(entity_ref("urn:case:kin:fit1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(KinDerivedK);
}

// Наблюдение 5/1 выше начальной 4/1: монотонный спад его не объясняет —
// готовый отказ observation_above_initial, подгонка молчит.

test "urn:query:calc-kin-kfit02-above-initial" {
    given {
        assert "kfit02-o": given_order(entity_ref("urn:case:kin:fit2"), 1) { origin case_input; }
        assert "kfit02-c0": given_initial_concentration(entity_ref("urn:case:kin:fit2"), 4, 1) { origin case_input; }
        assert "kfit02-obs": given_observed_concentration(entity_ref("urn:case:kin:fit2"), 5, 1) { origin case_input; }
        assert "kfit02-t": given_elapsed(entity_ref("urn:case:kin:fit2"), 2, 1) { origin case_input; }
        assert "kfit02-p": given_output_precision(entity_ref("urn:case:kin:fit2"), 3) { origin case_input; }
    }
    evaluate truth(observation_above_initial(entity_ref("urn:case:kin:fit2")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(kin_derived_k_value(entity_ref("urn:case:kin:fit2"), 0.693));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
    expect applied(ObservationAboveInitial);
}

// Порядок 0 — не первый: подгоночное правило молчит, отказа тоже нет.

test "urn:query:calc-kin-kfit03-order-guard" {
    given {
        assert "kfit03-o": given_order(entity_ref("urn:case:kin:fit3"), 0) { origin case_input; }
        assert "kfit03-c0": given_initial_concentration(entity_ref("urn:case:kin:fit3"), 4, 1) { origin case_input; }
        assert "kfit03-obs": given_observed_concentration(entity_ref("urn:case:kin:fit3"), 1, 1) { origin case_input; }
        assert "kfit03-t": given_elapsed(entity_ref("urn:case:kin:fit3"), 2, 1) { origin case_input; }
        assert "kfit03-p": given_output_precision(entity_ref("urn:case:kin:fit3"), 3) { origin case_input; }
    }
    evaluate truth(kin_derived_k_value(entity_ref("urn:case:kin:fit3"), 0.693));
    expect truth_status == NEITHER;
    evaluate truth(observation_above_initial(entity_ref("urn:case:kin:fit3")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
