test "urn:query:calc-kin-n06-fit-ok-with-caveat" {
    given {
        assert "n06-o": given_order(entity_ref("urn:case:kin:fit1"), 1) { origin case_input; }
        assert "n06-c": given_initial_concentration(entity_ref("urn:case:kin:fit1"), 1, 1) { origin case_input; }
        assert "n06-k": given_rate_constant(entity_ref("urn:case:kin:fit1"), 1, 10) { origin case_input; }
        assert "n06-t": given_elapsed(entity_ref("urn:case:kin:fit1"), 10, 1) { origin case_input; }
        assert "n06-q": given_observed_concentration(entity_ref("urn:case:kin:fit1"), 37, 100) { origin case_input; }
        assert "n06-p": given_output_precision(entity_ref("urn:case:kin:fit1"), 4) { origin case_input; }
    }
    evaluate truth(fit_residual_value(entity_ref("urn:case:kin:fit1"), 0.0021));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(FitResidualRounded);
    evaluate truth(fit_not_mechanism_proof(entity_ref("urn:case:kin:fit1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(FitCaveat);
}

