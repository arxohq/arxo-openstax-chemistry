language "law.core" version "0.2";
package openstax.chemistry_coordination version "0.1.0";
namespace "urn:openstax:clir:chemistry-coordination";

test "coord-sphere entry with a wrong layer is a layer mismatch" {
 given {
  assert "f0": row_claims(entity_ref("urn:openstax:matrix:m5"), "coord-sphere") { origin case_input; }
  assert "f1": row_formula(entity_ref("urn:openstax:matrix:m5"), "coordination sphere is the central metal plus attached ligands; brackets enclose it") { origin case_input; }
  assert "f2": row_layer(entity_ref("urn:openstax:matrix:m5"), "model") { origin case_input; }
  assert "f3": row_checker(entity_ref("urn:openstax:matrix:m5"), "unlinked: no computational checker journaled") { origin case_input; }
  assert "f4": row_fragment(entity_ref("urn:openstax:matrix:m5"), "section/19.2#coordination-sphere") { origin case_input; }
 }
 evaluate truth(matrix_gap(entity_ref("urn:openstax:matrix:m5"), "LAYER_MISMATCH"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(SphereLayerMismatch);
}
