        assert "h05-2": standard_state_presented(entity_ref("urn:case:chem:thermo:sys")) { origin case_input; }
    }
    evaluate truth(spontaneous_forward(entity_ref("urn:case:chem:thermo:sys")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

// Знак ΔG без предъявленного стандартного состояния вывод не даёт.
