language "law.core" version "0.2";
package openstax.chemistry_atomic version "0.1.0";
namespace "urn:openstax:clir:chemistry-atomic";

test "aufbau-model entry with a wrong layer is a layer mismatch" {
 given {
  assert "f0": row_claims(entity_ref("urn:openstax:matrix:m5"), "aufbau-model") { origin case_input; }
  assert "f1": row_formula(entity_ref("urn:openstax:matrix:m5"), "build configurations in order of atomic number following the orbital energy order") { origin case_input; }
  assert "f2": row_layer(entity_ref("urn:openstax:matrix:m5"), "observation") { origin case_input; }
  assert "f3": row_checker(entity_ref("urn:openstax:matrix:m5"), "calc.atomic_structure config") { origin case_input; }
  assert "f4": row_fragment(entity_ref("urn:openstax:matrix:m5"), "section/6.4#aufbau-principle") { origin case_input; }
 }
 evaluate truth(matrix_gap(entity_ref("urn:openstax:matrix:m5"), "LAYER_MISMATCH"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(AufbauLayerMismatch);
}
