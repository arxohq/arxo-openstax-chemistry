// Lewis Symbols and Structures — pinned chemistry-bonding/7.3.txt lines 17-17
fragment F_LEWIS_SYM in OPENSTAX_CHEMISTRY_BONDING_SEC {
    kind defn;
    locator "section/7.3#lewis-symbols";
    text en official """We use Lewis symbols to describe valence electron configurations of atoms and monatomic ions. A Lewis symbol consists of an elemental symbol surrounded by one dot for each of its valence electrons:""";
    content_hash "sha256:8c7dc1fe1d401b4d4e352a0d649957fca560b145e490291c5a6a16110e365f8a";
}

// Lewis Symbols and Structures — pinned chemistry-bonding/7.3.txt lines 49-49
fragment F_OCTET in OPENSTAX_CHEMISTRY_BONDING_SEC {
    kind paragraph;
    locator "section/7.3#octet-prediction";
    text en official """The number of bonds that an atom can form can often be predicted from the number of electrons needed to reach an octet (eight valence electrons); this is especially true of the nonmetals of the second period of the periodic table (C, N, O, and F). For example, each atom of a group 14 element has four electrons in its outermost shell and therefore requires four more electrons to reach an octet. These four electrons can be gained by forming four covalent bonds, as illustrated here for carbon in CCl4 (carbon tetrachloride) and silicon in SiH4 (silane). Because hydrogen only needs two electrons to fill its valence shell, it is an exception to the octet rule. The transition elements and inner transition elements also do not follow the octet rule:""";
    content_hash "sha256:5358f25d88a9a6e7630b11e8dad2ca3dcbad4ddc1e493a5d6a6dc8fc66b7cabe";
}

// Lewis Symbols and Structures — pinned chemistry-bonding/7.3.txt lines 43-43
fragment F_SINGLE_BOND in OPENSTAX_CHEMISTRY_BONDING_SEC {
    kind defn;
    locator "section/7.3#single-bond";
    text en official """A single shared pair of electrons is called a single bond. Each Cl atom interacts with eight valence electrons: the six in the lone pairs and the two in the single bond.""";
    content_hash "sha256:8922f7d44078e8890e06d4ea8723f5afff88ed97df90666f09a1fca151e5ebdf";
}
