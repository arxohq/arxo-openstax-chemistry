// calc.reaction_kinetics — закрытые решения ЗАДАННЫХ законов скорости
// порядков 0, 1 и 2 плюс Аррениус (DECISION-0123).
//
// ЧТО ЭТОТ ПАКЕТ ДЕЛАЕТ. Ему предъявляют порядок n ∈ {0,1,2} как ВХОДНУЮ
// МОДЕЛЬ, начальную концентрацию, константу скорости при T₁, сдвиг времени
// и (для обратных вопросов) целевую концентрацию, а для переноса по T —
// энергию активации, R и обе температуры. Он возвращает c(t), обратное
// время, t½ и отношение k(T₂)/k(T₁). Всё это — обычные правила Law DSL.
//
// ЧЕГО ОН НЕ ДЕЛАЕТ, И ЭТО ГРАНИЦЫ, А НЕ ПРОБЕЛЫ. Порядок из стехиометрии
// НЕ выводится: стехиометрических входов здесь нет вовсе, и вывести не из
// чего. Параметры из данных НЕ оцениваются: подгонки нет. Общего численного
// интегратора НЕТ: только три закрытые формы. Переноса по T без Ea НЕТ:
// просьба без энергии получает именованный отказ, а не экстраполяцию.
//
// ТОЧНОСТЬ — ТА ЖЕ ДИСЦИПЛИНА, ЧТО У СОСЕДЕЙ. Входы — пары целых
// (E-0020); порядки 0 и 2 — точные Rational одним делением; порядок 1
// и Аррениус — сертифицированные границы `ln_bounds`/`exp_bounds` §259.2
// с профилем `p16/0.1`. Все порядки сводятся к единым головам
// (`concentration_bounds` и далее): точные оборачиваются `bounds::exact`.
// Округлённая голова сходится, лишь когда оба конца легли в одну ячейку.
//
// НУЛЕВОЙ ПОРЯДОК ОСТАНАВЛИВАЕТСЯ ПРИ c = 0. Решение c₀ − kt уходит в минус
// за истощением: граница истощения названа парой взаимоисключающих голов
// (`depleted` против концентрации), отрицательной концентрации нет.
//
// ПРАВИЛА НЕ `pub`, ОТНОШЕНИЯ `pub`: потребителю нужен интерфейс, а не
// имена шагов; `pub rule` без якоря копил бы долг разметки (LDC-W1301).

language "law.core" version "0.2";
package calc.reaction_kinetics version "0.1.0";
namespace "urn:law:calc:reaction-kinetics";

pub entity Calculation {
    label ru unofficial "кинетический расчёт, предъявленный делом: порядок как входная модель, начальное состояние и вопрос о нём";
    label en unofficial "a kinetic calculation presented by the case: the order as an input model, the initial state and the question asked of it";
}
