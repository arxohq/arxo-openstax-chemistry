}

test "urn:query:os-eq-03-no-comparison" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
            timezone "UTC";
        }
        assert "e03-q": reaction_in_question(entity_ref("urn:case:chem:eq:haber")) { origin case_input; }
    }
    evaluate truth(shifts_toward_products(entity_ref("urn:case:chem:eq:haber")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "urn:query:os-eq-04-ice" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
            timezone "UTC";
        }
        assert "e04-q": reaction_in_question(entity_ref("urn:case:chem:eq:haber")) { origin case_input; }
        assert "e04-1": mass_balances_presented(entity_ref("urn:case:chem:eq:haber")) { origin case_input; }
    }
    evaluate truth(equilibrium_composition_computable(entity_ref("urn:case:chem:eq:haber")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(EquilibriumCompositionComputable);
}

// Без предъявленной температуры сравнение Q/K не читается: K определена
// при данной T (закон действующих масс, 13.2).
test "urn:query:os-eq-05-no-temperature" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
            timezone "UTC";
        }
        assert "e05-q": reaction_in_question(entity_ref("urn:case:chem:eq:haber")) { origin case_input; }
        assert "e05-1": quotient_below_constant(entity_ref("urn:case:chem:eq:haber")) { origin case_input; }
        assert "e05-2": standard_state_presented(entity_ref("urn:case:chem:eq:haber")) { origin case_input; }
    }
    evaluate truth(shifts_toward_products(entity_ref("urn:case:chem:eq:haber")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

// Без предъявленного стандартного состояния сравнение Q/K не читается.
