        assert "r11-calc": run_calculation(entity_ref("urn:case:chem:kin:arrno"), entity_ref("urn:case:chem:kin:arrno-calc")) { origin case_input; }
        assert "r11-noea": run_no_activation_energy(entity_ref("urn:case:chem:kin:arrno")) { origin case_input; }
        assert "r11-t": run_temperature_pair(entity_ref("urn:case:chem:kin:arrno"), 300, 1, 310, 1) { origin case_input; }
    }
    evaluate truth(run_transfer_refused(entity_ref("urn:case:chem:kin:arrno")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(RunTransferRefused);
}
