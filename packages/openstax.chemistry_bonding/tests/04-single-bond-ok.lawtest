language "law.core" version "0.2";
package openstax.chemistry_bonding version "0.1.0";
namespace "urn:openstax:clir:chemistry-bonding";

test "single-bond observation entry is covered" {
 given {
  assert "f0": row_claims(entity_ref("urn:openstax:matrix:m04"), "single-bond") { origin case_input; }
  assert "f1": row_formula(entity_ref("urn:openstax:matrix:m04"), "a single shared pair is a single bond; each Cl sees eight valence electrons") { origin case_input; }
  assert "f2": row_layer(entity_ref("urn:openstax:matrix:m04"), "observation") { origin case_input; }
  assert "f3": row_checker(entity_ref("urn:openstax:matrix:m04"), "calc.lewis_structures bond-order") { origin case_input; }
  assert "f4": row_fragment(entity_ref("urn:openstax:matrix:m04"), "section/7.3#single-bond") { origin case_input; }
 }
 evaluate truth(claim_covered(entity_ref("urn:openstax:matrix:m04")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(SingleBondCovered);
}
