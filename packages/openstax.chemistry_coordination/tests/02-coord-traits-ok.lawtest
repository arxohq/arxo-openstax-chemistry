language "law.core" version "0.2";
package openstax.chemistry_coordination version "0.1.0";
namespace "urn:openstax:clir:chemistry-coordination";

test "coord-traits definition entry is covered" {
 given {
  assert "f0": row_claims(entity_ref("urn:openstax:matrix:m02"), "coord-traits") { origin case_input; }
  assert "f1": row_formula(entity_ref("urn:openstax:matrix:m02"), "coordination compounds show complexes with mono/polydentate ligands, nomenclature, isomerism, occurrences") { origin case_input; }
  assert "f2": row_layer(entity_ref("urn:openstax:matrix:m02"), "definition") { origin case_input; }
  assert "f3": row_checker(entity_ref("urn:openstax:matrix:m02"), "unlinked: no computational checker journaled") { origin case_input; }
  assert "f4": row_fragment(entity_ref("urn:openstax:matrix:m02"), "section/19.2#coordination-traits") { origin case_input; }
 }
 evaluate truth(claim_covered(entity_ref("urn:openstax:matrix:m02")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(TraitsCovered);
}
