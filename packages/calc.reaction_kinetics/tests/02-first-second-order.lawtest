        assert "s02-k": given_rate_constant(entity_ref("urn:case:kin:st"), 1, 4) { origin case_input; }
        assert "s02-q": given_target_concentration(entity_ref("urn:case:kin:st"), 1, 1) { origin case_input; }
        assert "s02-p": given_output_precision(entity_ref("urn:case:kin:st"), 3) { origin case_input; }
