// Без знака ΔG самопроизвольность не выводится.
test "urn:query:os-thermo-04-no-sign" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
            timezone "UTC";
        }
        assert "h04-q": system_in_question(entity_ref("urn:case:chem:thermo:sys")) { origin case_input; }
    }
    evaluate truth(spontaneous_forward(entity_ref("urn:case:chem:thermo:sys")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

// Знак ΔG без предъявленных T, p вывод не даёт (16.4: «при T, p»).
