language "law.core" version "0.2";
package openstax.chemistry_coordination version "0.1.0";
namespace "urn:openstax:clir:chemistry-coordination";

// Честная фиксация остатка: вычислительного соседа в корпусе нет
// (final-tally-recon GAP), привязка явно отложена — checker_pending.
test "coord-numbers entry is source-anchored but checker-pending" {
 given {
  assert "f0": row_claims(entity_ref("urn:openstax:matrix:m6"), "coord-numbers") { origin case_input; }
  assert "f1": row_formula(entity_ref("urn:openstax:matrix:m6"), "[Ag(NH3)2]+, [Cu(Cl)4]2-, [Co(H2O)6]2+ have coordination numbers 2, 4, 6") { origin case_input; }
  assert "f2": row_layer(entity_ref("urn:openstax:matrix:m6"), "observation") { origin case_input; }
  assert "f3": row_checker(entity_ref("urn:openstax:matrix:m6"), "unlinked: no computational checker journaled") { origin case_input; }
  assert "f4": row_fragment(entity_ref("urn:openstax:matrix:m6"), "section/19.2#coordination-numbers") { origin case_input; }
 }
 evaluate truth(checker_pending(entity_ref("urn:openstax:matrix:m6")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(CoordNumbersCheckerPending);
}
