language "law.core" version "0.2";
package openstax.chemistry_acids version "0.1.0";
namespace "urn:openstax:clir:chemistry-acids";

// Сцены §14.7: точки кривой титрования и различие эквивалентности и
// конечной точки. Молчание дела — NEITHER, а не отрицание.

// Сильная кислота + сильное основание: в эквивалентности нейтрально.
test "urn:query:openstax-chem-titration-01-strong-neutral" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
            timezone "UTC";
        }
        assert "t01-q": titration_in_question(entity_ref("urn:case:chem:titration:hcl-naoh")) { origin case_input; }
        assert "t01-1": strong_acid_strong_base(entity_ref("urn:case:chem:titration:hcl-naoh")) { origin case_input; }
        assert "t01-2": titration_temperature_presented(entity_ref("urn:case:chem:titration:hcl-naoh")) { origin case_input; }
        assert "t01-3": fixed_conditions_presented(entity_ref("urn:case:chem:titration:hcl-naoh")) { origin case_input; }
    }
    evaluate truth(neutral_at_equivalence(entity_ref("urn:case:chem:titration:hcl-naoh")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(StrongStrongNeutralAtEquivalence);
}

// Слабая кислота + сильное основание: в эквивалентности основно.
test "urn:query:openstax-chem-titration-02-weak-basic" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
            timezone "UTC";
        }
        assert "t02-q": titration_in_question(entity_ref("urn:case:chem:titration:hoac-naoh")) { origin case_input; }
        assert "t02-1": weak_acid_strong_base(entity_ref("urn:case:chem:titration:hoac-naoh")) { origin case_input; }
        assert "t02-2": titration_temperature_presented(entity_ref("urn:case:chem:titration:hoac-naoh")) { origin case_input; }
        assert "t02-3": fixed_conditions_presented(entity_ref("urn:case:chem:titration:hoac-naoh")) { origin case_input; }
    }
    evaluate truth(basic_at_equivalence(entity_ref("urn:case:chem:titration:hoac-naoh")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(WeakAcidBasicAtEquivalence);
}

// Половина эквивалентности слабой кислоты: pH = pKa.
test "urn:query:openstax-chem-titration-03-half-pka" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
            timezone "UTC";
        }
        assert "t03-q": titration_in_question(entity_ref("urn:case:chem:titration:hoac-naoh")) { origin case_input; }
        assert "t03-1": weak_acid_strong_base(entity_ref("urn:case:chem:titration:hoac-naoh")) { origin case_input; }
        assert "t03-2": half_equivalence_point(entity_ref("urn:case:chem:titration:hoac-naoh")) { origin case_input; }
        assert "t03-3": titration_temperature_presented(entity_ref("urn:case:chem:titration:hoac-naoh")) { origin case_input; }
        assert "t03-4": fixed_conditions_presented(entity_ref("urn:case:chem:titration:hoac-naoh")) { origin case_input; }
    }
    evaluate truth(ph_equals_pka_at_half_equivalence(entity_ref("urn:case:chem:titration:hoac-naoh")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(HalfEquivalencePhEqualsPka);
}

// Сильной системе основной эквивалентности нет: молчание, не отрицание.
test "urn:query:openstax-chem-titration-04-strong-not-basic" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
            timezone "UTC";
        }
        assert "t04-q": titration_in_question(entity_ref("urn:case:chem:titration:hcl-naoh")) { origin case_input; }
        assert "t04-1": strong_acid_strong_base(entity_ref("urn:case:chem:titration:hcl-naoh")) { origin case_input; }
    }
    evaluate truth(basic_at_equivalence(entity_ref("urn:case:chem:titration:hcl-naoh")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

// Без предъявленной системы выводов нет.
test "urn:query:openstax-chem-titration-05-missing-system" {
    given {
