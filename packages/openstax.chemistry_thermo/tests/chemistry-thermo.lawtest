language "law.core" version "0.2";
package openstax.chemistry_thermo version "0.1.1";
namespace "urn:openstax:clir:chemistry-thermo";

test "urn:query:os-thermo-01-hess" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
            timezone "UTC";
        }
        assert "h01-q": reaction_in_question(entity_ref("urn:case:chem:thermo:ch4")) { origin case_input; }
        assert "h01-1": formation_data_complete(entity_ref("urn:case:chem:thermo:ch4")) { origin case_input; }
    }
    evaluate truth(hess_path_independent(entity_ref("urn:case:chem:thermo:ch4")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(HessPathIndependent);
}

test "urn:query:os-thermo-02-spontaneous" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
            timezone "UTC";
        }
        assert "h02-q": system_in_question(entity_ref("urn:case:chem:thermo:sys")) { origin case_input; }
        assert "h02-1": negative_gibbs_presented(entity_ref("urn:case:chem:thermo:sys")) { origin case_input; }
        assert "h02-2": system_temperature_pressure_presented(entity_ref("urn:case:chem:thermo:sys")) { origin case_input; }
        assert "h02-3": standard_state_presented(entity_ref("urn:case:chem:thermo:sys")) { origin case_input; }
    }
    evaluate truth(spontaneous_forward(entity_ref("urn:case:chem:thermo:sys")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(SpontaneousForward);
}

test "urn:query:os-thermo-03-nonspontaneous" {
    given {
