language "law.core" version "0.2";
package openstax.chemistry_atomic version "0.1.0";
namespace "urn:openstax:clir:chemistry-atomic";

test "config-def definition entry is covered" {
 given {
  assert "f0": row_claims(entity_ref("urn:openstax:matrix:m02"), "config-def") { origin case_input; }
  assert "f1": row_formula(entity_ref("urn:openstax:matrix:m02"), "electron configuration is the arrangement of electrons in orbitals; it determines chemical properties") { origin case_input; }
  assert "f2": row_layer(entity_ref("urn:openstax:matrix:m02"), "definition") { origin case_input; }
  assert "f3": row_checker(entity_ref("urn:openstax:matrix:m02"), "calc.atomic_structure config") { origin case_input; }
  assert "f4": row_fragment(entity_ref("urn:openstax:matrix:m02"), "section/6.4#electron-configuration") { origin case_input; }
 }
 evaluate truth(claim_covered(entity_ref("urn:openstax:matrix:m02")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(ConfigCovered);
}
