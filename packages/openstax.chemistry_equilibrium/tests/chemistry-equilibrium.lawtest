language "law.core" version "0.2";
package openstax.chemistry_equilibrium version "0.1.0";
namespace "urn:openstax:clir:chemistry-equilibrium";

test "urn:query:os-eq-01-forward" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
            timezone "UTC";
        }
        assert "e01-q": reaction_in_question(entity_ref("urn:case:chem:eq:haber")) { origin case_input; }
        assert "e01-1": quotient_below_constant(entity_ref("urn:case:chem:eq:haber")) { origin case_input; }
        assert "e01-2": reaction_temperature_presented(entity_ref("urn:case:chem:eq:haber")) { origin case_input; }
        assert "e01-3": standard_state_presented(entity_ref("urn:case:chem:eq:haber")) { origin case_input; }
    }
    evaluate truth(shifts_toward_products(entity_ref("urn:case:chem:eq:haber")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(ShiftsTowardProducts);
}

test "urn:query:os-eq-02-backward" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
