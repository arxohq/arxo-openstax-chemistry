test "urn:query:calc-kin-n04-catalyst-ok" {
    given {
        assert "n04-e": given_activation_energy(entity_ref("urn:case:kin:cat1"), 50000, 1) { origin case_input; }
        assert "n04-ec": given_catalyzed_activation_energy(entity_ref("urn:case:kin:cat1"), 40000, 1) { origin case_input; }
        assert "n04-r": given_gas_constant(entity_ref("urn:case:kin:cat1"), 8314, 1000) { origin case_input; }
        assert "n04-t": given_catalyst_temperature(entity_ref("urn:case:kin:cat1"), 300, 1) { origin case_input; }
        assert "n04-p": given_output_precision(entity_ref("urn:case:kin:cat1"), 2) { origin case_input; }
    }
    evaluate truth(catalyst_lowers_barrier(entity_ref("urn:case:kin:cat1")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(CatalystLowersBarrier);
    evaluate truth(catalyst_speedup_value(entity_ref("urn:case:kin:cat1"), 55.11));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(CatalystSpeedupRounded);
}

