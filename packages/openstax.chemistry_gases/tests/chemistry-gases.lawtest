language "law.core" version "0.2";
package openstax.chemistry_gases version "0.1.1";
namespace "urn:openstax:clir:chemistry-gases";

test "urn:query:os-gas-01-ideal" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
            timezone "UTC";
        }
        assert "g01-q": gas_sample_in_question(entity_ref("urn:case:chem:gas:co2")) { origin case_input; }
        assert "g01-1": absolute_temperature_presented(entity_ref("urn:case:chem:gas:co2")) { origin case_input; }
    }
    evaluate truth(ideal_gas_model_licensed(entity_ref("urn:case:chem:gas:co2")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(IdealGasModelLicensed);
}

test "urn:query:os-gas-02-no-temperature" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
            timezone "UTC";
        }
        assert "g02-q": gas_sample_in_question(entity_ref("urn:case:chem:gas:co2")) { origin case_input; }
    }
    evaluate truth(ideal_gas_model_licensed(entity_ref("urn:case:chem:gas:co2")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}

test "urn:query:os-gas-03-stoichiometry-link" {
    given {
        context {
            decision_time @2026-09-27T12:00:00Z;
            knowledge_time @2026-09-27T12:00:00Z;
            legal_time @2026-09-27;
            timezone "UTC";
        }
        assert "g03-q": gas_sample_in_question(entity_ref("urn:case:chem:gas:co2")) { origin case_input; }
        assert "g03-1": dry_sample_presented(entity_ref("urn:case:chem:gas:co2")) { origin case_input; }
    }
    evaluate truth(amount_links_to_gas_volume(entity_ref("urn:case:chem:gas:co2")));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(AmountLinksToGasVolume);
}
