language "law.core" version "0.2";
package openstax.chemistry_coordination version "0.1.0";
namespace "urn:openstax:clir:chemistry-coordination";

// Источниковый срез B23.09: три строки §19.2 (признаки — определение, сфера — определение, координационные числа — наблюдение); вычислительного соседа в корпусе нет — привязка явно отложена. Наблюдение, определение и учебная
// модель размечены отдельно (B23.09); каждая строка привязана к точному
// фрагменту и к вычислительному соседу.
// Литералы правил — сам срез; тесты предъявляют верные/неверные строки.

use self::{
    F_COORD_NUMBERS,
    F_SPHERE,
    F_TRAITS,
};

@source(F_TRAITS)
pub entity MatrixRow {
    label en official "claimed source-slice entry under test";
    label ru unofficial "проверяемая строка источникового среза";
}

@source(F_TRAITS)
pub relation row_claims(r: MatrixRow { label ru unofficial "r"; }, rule_id: Text { label ru unofficial "идентификатор утверждения учебника"; }) kind empirical {
    label en official "row claims to cover a textbook statement";
    label ru unofficial "строка заявляет покрытие утверждения учебника";
}

@source(F_TRAITS)
pub relation row_formula(r: MatrixRow { label ru unofficial "r"; }, formula: Text { label ru unofficial "формулировка"; }) kind empirical {
    label en official "statement text as presented";
    label ru unofficial "предъявленная формулировка утверждения";
}

@source(F_TRAITS)
pub relation row_layer(r: MatrixRow { label ru unofficial "r"; }, layer: Text { label ru unofficial "слой"; }) kind empirical {
    label en official "observation/definition/model layer as presented";
    label ru unofficial "предъявленный слой: наблюдение/определение/модель";
}

@source(F_TRAITS)
pub relation row_checker(r: MatrixRow { label ru unofficial "r"; }, checker: Text { label ru unofficial "проверяющий"; }) kind empirical {
    label en official "checker linkage as presented";
    label ru unofficial "предъявленная привязка к проверяющему";
}

@source(F_TRAITS)
pub relation row_fragment(r: MatrixRow { label ru unofficial "r"; }, fragment_locator: Text { label ru unofficial "фрагмент"; }) kind empirical {
    label en official "source fragment locator as presented";
    label ru unofficial "предъявленный локатор фрагмента источника";
}

@source(F_TRAITS)
pub relation claim_covered(r: MatrixRow { label ru unofficial "r"; }) kind derived {
    label en official "slice entry is layered and source-anchored";
    label ru unofficial "строка среза размечена по слоям и привязана к источнику";
}

@source(F_TRAITS)
pub relation matrix_gap(r: MatrixRow { label ru unofficial "r"; }, reason: Text { label ru unofficial "причина"; }) kind derived {
    label en official "slice entry defect with a named reason";
    label ru unofficial "дефект строки среза с именованной причиной";
}

@source(F_TRAITS)
pub relation checker_pending(r: MatrixRow { label ru unofficial "r"; }) kind derived {
    label en official "entry is source-anchored but has no computational checker yet";
    label ru unofficial "строка привязана к источнику, но вычислительного проверяющего пока нет";
}

// B23.09 acceptance: неразмеченная строка (без слоя) покрытием не является.


@source(F_TRAITS)
rule TraitsCovered(r: MatrixRow) strict {
    label en official "coordination traits entry is covered";
    label ru unofficial "строка-признаки покрыта";
    when row_claims(r, "coord-traits")
        and row_formula(r, "coordination compounds show complexes with mono/polydentate ligands, nomenclature, isomerism, occurrences")
        and row_layer(r, "definition")
        and row_checker(r, "unlinked: no computational checker journaled")
        and row_fragment(r, "section/19.2#coordination-traits");
    then claim_covered(r);
}


@source(F_SPHERE)
rule SphereCovered(r: MatrixRow) strict {
    label en official "coordination sphere entry is covered";
    label ru unofficial "строка-сфера покрыта";
    when row_claims(r, "coord-sphere")
        and row_formula(r, "coordination sphere is the central metal plus attached ligands; brackets enclose it")
        and row_layer(r, "definition")
        and row_checker(r, "unlinked: no computational checker journaled")
        and row_fragment(r, "section/19.2#coordination-sphere");
    then claim_covered(r);
}


@source(F_COORD_NUMBERS)
rule CoordNumbersCovered(r: MatrixRow) strict {
    label en official "coordination numbers entry is covered";
    label ru unofficial "строка-наблюдение координационных чисел покрыта";
    when row_claims(r, "coord-numbers")
        and row_formula(r, "[Ag(NH3)2]+, [Cu(Cl)4]2-, [Co(H2O)6]2+ have coordination numbers 2, 4, 6")
        and row_layer(r, "observation")
        and row_checker(r, "unlinked: no computational checker journaled")
        and row_fragment(r, "section/19.2#coordination-numbers");
    then claim_covered(r);
}


@source(F_SPHERE)
rule SphereLayerMismatch(r: MatrixRow, v: Text) strict {
    label en official "coord-sphere entry with a wrong layer is a named gap";
    label ru unofficial "строка coord-sphere с неверным слоем — именованный зазор";
    when row_claims(r, "coord-sphere") and row_layer(r, v) and v != "definition";
    then matrix_gap(r, "LAYER_MISMATCH");
}


@source(F_TRAITS)
rule TraitsCheckerPending(r: MatrixRow) strict {
    label en official "coord-traits entry is source-anchored but checker-pending";
    label ru unofficial "строка coord-traits привязана к источнику, проверяющий отложен";
    when row_claims(r, "coord-traits") and row_checker(r, "unlinked: no computational checker journaled");
    then checker_pending(r);
}


@source(F_SPHERE)
rule SphereCheckerPending(r: MatrixRow) strict {
    label en official "coord-sphere entry is source-anchored but checker-pending";
    label ru unofficial "строка coord-sphere привязана к источнику, проверяющий отложен";
    when row_claims(r, "coord-sphere") and row_checker(r, "unlinked: no computational checker journaled");
    then checker_pending(r);
}


@source(F_COORD_NUMBERS)
rule CoordNumbersCheckerPending(r: MatrixRow) strict {
    label en official "coord-numbers entry is source-anchored but checker-pending";
    label ru unofficial "строка coord-numbers привязана к источнику, проверяющий отложен";
    when row_claims(r, "coord-numbers") and row_checker(r, "unlinked: no computational checker journaled");
    then checker_pending(r);
}
